# Python
__pycache__/
*.py[oc]
*.egg-info
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Environments (one per backend: .venv, .venv-pypy, and their -wsl variants). No trailing
# slash here and below: git reads one as "folders only", and a link to a folder on another disk,
# which ./pyt clean supports, was committed and broke every other clone
.venv*

# ./pyt outputs (mypyc stage, PyInstaller, runtimes, reports) and artifacts: the root's own
# only (a leading /), since src/<pkg>/build/ or tests/dist/ is source like any other
/.build
/dist
/build
/*.spec

# Compiled extensions: mypyc's live in .build/ (one in src/ is a stray build); a vendored
# native .so/.pyd in src/ must be added with `git add -f` (builds ship it; a pure pyz cannot)
*.so
*.pyd

# Flet (flet run / flet build)
.flet/

# Claude Code: agent worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json
