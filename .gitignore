# Python
__pycache__/
*.py[oc]
*.egg-info
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Environments (one per backend: .venv, .venv-pypy, and their -wsl variants)
.venv*/

# ./pyt outputs (mypyc stage, PyInstaller, runtimes, reports) and artifacts
.build/
dist/
build/
*.spec

# Compiled extensions: mypyc's live in .build/ (one in src/ is a stray build); a vendored
# native .so/.pyd in src/ must be added with `git add -f` (builds ship it; a pure pyz cannot)
*.so
*.pyd

# Flet (flet run / flet build)
.flet/

# Claude Code: agent worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json
