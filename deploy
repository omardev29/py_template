#!/bin/sh
# POSIX launcher for ./deploy (bash, zsh, fish, xonsh on Linux/macOS, Git Bash).
# It only finds uv and forwards the arguments: all the logic is in .pytemplate/deploy.py.
# The #!/bin/sh shebang is on purpose: on Windows, xonsh turns "/usr/bin/env bash" into `bash`,
# which may be WSL's; `sh` is Git's.
set -eu

if ! command -v uv >/dev/null 2>&1; then
    for d in "${UV_INSTALL_DIR:-}" "${XDG_BIN_HOME:-}" "$HOME/.local/bin" "$HOME/.cargo/bin"; do
        if [ -n "$d" ] && [ -x "$d/uv" ]; then
            PATH="$d:$PATH"
            export PATH
            break
        fi
    done
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "deploy: uv not found (https://docs.astral.sh/uv/)." >&2
    if [ -t 0 ] && [ -t 1 ]; then
        printf "Install it now with the official installer? [y/N] " >&2
        read -r answer || answer=""
        case "$answer" in
            y | Y | yes | Yes | YES)
                if command -v curl >/dev/null 2>&1; then
                    curl -LsSf https://astral.sh/uv/install.sh | sh
                else
                    wget -qO- https://astral.sh/uv/install.sh | sh
                fi
                PATH="${UV_INSTALL_DIR:-$HOME/.local/bin}:$PATH"
                export PATH
                ;;
        esac
    fi
    if ! command -v uv >/dev/null 2>&1; then
        echo "Install it with:  curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
        exit 127
    fi
fi

PYTEMPLATE_CALLER_CWD=$PWD
export PYTEMPLATE_CALLER_CWD
exec uv run --quiet --script "$(dirname -- "$0")/.pytemplate/deploy.py" "$@"
