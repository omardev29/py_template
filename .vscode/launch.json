// GENERADO por ./deploy a partir de pytemplate.toml y .pytemplate/templates: no lo edites a mano
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "src/main.py (CPython, interpretado)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
